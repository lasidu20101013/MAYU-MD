# ===========================================
# MAYU MD - settings
# Copy to ".env" on a VPS / PC. On Heroku / Render / Kurox set these as
# environment variables instead.
# ===========================================

# MongoDB connection string (required) - everything is stored here
MONGODB_URI=
MONGODB_DB=mayu-md

# You (required) - number with country code, no +
OWNER_NUMBER=
OWNER_NAME=
BOT_NAME=MAYU MD

# Your bot website address, e.g. https://mayu-md.onrender.com
PUBLIC_URL=

# Password for the /owner dashboard (12+ characters)
OWNER_PANEL_PASSWORD=

PREFIX=.
MULTI_PREFIX=true
MODE=public

# Optional: Groq key for the AI commands (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: your own channel / group (leave empty to turn off)
SUPPORT_CHANNEL=
CHANNEL_JID=
AUTO_FOLLOW_CHANNEL=false
AUTO_JOIN_GROUP=false
AUTO_JOIN_GROUP_LINK=

AUTO_READ_STATUS=true
AUTO_LIKE_STATUS=true
ALWAYS_ONLINE=true
ANTI_DELETE=true
ANTI_CALL=true

# Optional third-party API key. Add your own key in the hosting dashboard.
API_KEY=
